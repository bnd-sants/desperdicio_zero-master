# Configurações do Supabase
SUPABASE_URL=seu_url_do_supabase
SUPABASE_ANON_KEY=sua_chave_anonima_do_supabase

# URLs de redirecionamento para autenticação
# Substitua 'com.example.desperdicio_zero' pelo bundle ID do seu app
SUPABASE_REDIRECT_URL=com.example.desperdicio_zero://auth-callback
SUPABASE_RESET_PASSWORD_URL=com.example.desperdicio_zero://reset-password

# Chave da API do Spoonacular (para busca de receitas)
SPOONACULAR_API_KEY=sua_chave_da_api_spoonacular

# Configurações de Deep Linking
DEEP_LINK_SCHEMA=com.example.desperdicio_zero
DEEP_LINK_DOMAIN=seu_dominio.com

# Configurações adicionais de autenticação
# Descomente e preencha se estiver usando autenticação social
# GOOGLE_CLIENT_ID=seu_google_client_id
# APPLE_CLIENT_ID=seu_apple_client_id
# FACEBOOK_APP_ID=seu_facebook_app_id

# Configurações de autenticação social (se aplicável)
# GOOGLE_CLIENT_ID=seu_google_client_id
# APPLE_CLIENT_ID=seu_apple_client_id
# FACEBOOK_APP_ID=seu_facebook_app_id

# Outras configurações
# DEBUG=true
# ENVIRONMENT=development
